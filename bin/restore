#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 1 ]; then
  echo "Использование: $0 <каталог_бэкапов>"
  exit 1
fi

BACKUP_DIR="$1"

BACKUP_FILE="$(ls -1t "$BACKUP_DIR"/*.sql.gz 2>/dev/null | head -n1 || true)"
if [ -z "$BACKUP_FILE" ]; then
  echo "В каталоге '$BACKUP_DIR' бэкапы не найдены."
  exit 1
fi

# Параметры подключения к MySQL (совпадают с docker-compose.yml / .env.local).
DB_SERVICE="${DB_SERVICE:-mysql}"
DB_NAME="${MYSQL_DATABASE:-poethrenoff}"
DB_USER="${MYSQL_USER:-poethrenoff}"
DB_PASSWORD="${MYSQL_PASSWORD:-poethrenoff}"

echo "Восстановление БД из $BACKUP_FILE ..."
gunzip -c "$BACKUP_FILE" | docker compose exec -T -e "MYSQL_PWD=$DB_PASSWORD" "$DB_SERVICE" \
  mysql --user="$DB_USER" "$DB_NAME"

echo "Готово."
