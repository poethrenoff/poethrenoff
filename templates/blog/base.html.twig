<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Не дождетесь!{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('assets/normalize.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/blog.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <div class="container">
        <header>
            <div class="site-title">
                <a href="{{ path('blog_homepage') }}">Не дождетесь!</a>
            </div>
            <nav class="nav-links">
                <a href="//lo.poethrenoff.ru/">Сайт</a>
                <a href="{{ path('blog_search') }}">Поиск</a>
            </nav>
        </header>

        <main>
            {% block body %}{% endblock %}
        </main>
    </div>

    {% block javascripts %}{% endblock %}
</body>
</html>
