{% extends 'blog/base.html.twig' %}

{% block body %}
    <div class="search-form">
        <form action="{{ path('blog_search') }}" method="get">
            <input type="text" name="text" value="{{ searchText }}" placeholder="Поиск по блогу..." class="search-input">
            <button type="submit" class="search-button">Искать</button>
        </form>
    </div>

    <div class="tag-cloud">
        {% for tag in tags %}
            <a href="{{ path('blog_search', {tag: tag[0].title}) }}" class="tag {% if tag[0].title == currentTag %}active{% endif %}">
                {{ tag[0].title }}
            </a>
        {% endfor %}
    </div>

    {% if searchResults is not empty %}
        <h2>Результаты поиска {% if currentTag %}по тегу "{{ currentTag }}"{% elseif searchText %}для "{{ searchText }}"{% endif %}</h2>

        {% for post in searchResults %}
            <article class="post">
                <h3>
                    <a href="{{ path('blog_post', {id: post.id}) }}">
                        {{ post.publishedAt|date('d.m.Y H:i') }}
                    </a>
                </h3>
                <div class="post-content">
                    {{ post.content|raw }}
                </div>
                {% if post.tags|length > 0 %}
                    <div class="post-tags">
                        {% for tag in post.tags %}
                            <a href="{{ path('blog_search', {tag: tag.title}) }}" class="tag">{{ tag.title }}</a>
                        {% endfor %}
                    </div>
                {% endif %}
            </article>
        {% endfor %}

        {% if pagination is defined and pagination.total_pages > 1 %}
            <div class="pagination">
                {% if pagination.prev_page %}
                    <a href="{{ path('blog_search', app.request.query.all|merge({'page': pagination.prev_page})) }}" class="pagination-link">&laquo; Назад</a>
                {% endif %}

                {% for page in range(1, pagination.total_pages) %}
                    {% if page == pagination.current_page %}
                        <span class="pagination-current">{{ page }}</span>
                    {% elseif page in [pagination.current_page - 2, pagination.current_page - 1, pagination.current_page + 1, pagination.current_page + 2] %}
                        <a href="{{ path('blog_search', app.request.query.all|merge({'page': page})) }}" class="pagination-link">{{ page }}</a>
                    {% elseif page == 1 or page == pagination.total_pages %}
                        <a href="{{ path('blog_search', app.request.query.all|merge({'page': page})) }}" class="pagination-link">{{ page }}</a>
                    {% elseif page == pagination.current_page - 3 or page == pagination.current_page + 3 %}
                        <span class="pagination-ellipsis">...</span>
                    {% endif %}
                {% endfor %}

                {% if pagination.next_page %}
                    <a href="{{ path('blog_search', app.request.query.all|merge({'page': pagination.next_page})) }}" class="pagination-link">Вперед &raquo;</a>
                {% endif %}
            </div>
        {% endif %}
    {% elseif searchText or currentTag %}
        <p>Ничего не найдено.</p>
    {% endif %}
{% endblock %}
