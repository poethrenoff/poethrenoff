{% extends 'blog/base.html.twig' %}

{% block body %}
    <article class="post">
        <h3>
            <a href="{{ path('blog_post', {id: post.id}) }}">
                {{ post.publishedAt|date('d.m.Y H:i') }}
            </a>
        </h3>
        <div class="post-content">
            {{ post.content|raw }}
        </div>
        {% if post.tags|length > 0 %}
            <div class="post-tags">
                {% for tag in post.tags %}
                    <a href="{{ path('blog_search', {tag: tag.title}) }}" class="tag">{{ tag.title }}</a>
                {% endfor %}
            </div>
        {% endif %}
    </article>

    <section class="comments-section">
        <h3>Комментарии</h3>
        {% if rootComments is not empty %}
            {{ include('blog/_comment_tree.html.twig', {comments: rootComments}) }}
        {% else %}
            <p>Комментариев пока нет.</p>
        {% endif %}
    </section>
{% endblock %}
