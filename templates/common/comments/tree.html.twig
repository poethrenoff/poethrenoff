{% for comment in comments %}
    <div class="comment" id="comment-{{ comment.id }}">
        <div class="comment-header">
            <span class="comment-author">{{ comment.author }}</span>
            <span class="comment-date">{{ comment.createdAt|date('d.m.Y H:i') }}</span>
        </div>
        <div class="comment-content">
            {{ comment.content|raw }}
        </div>
        <div class="comment-actions">
            <a href="#" class="comment-toggle-link" data-target="{{ comment.id }}">Ответить</a>
        </div>


        {% if comment.children|length > 0 %}
            <div class="comment-children">
                {% set activeChildren = [] %}
                {% for child in comment.children %}
                    {% if child.isActive %}
                        {% set activeChildren = activeChildren|merge([child]) %}
                    {% endif %}
                {% endfor %}

                {% if activeChildren|length > 0 %}
                    {{ include('common/comments/tree.html.twig', {comments: activeChildren}) }}
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endfor %}
