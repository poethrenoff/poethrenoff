<div class="comment-form-container" id="comment-form" 
     data-comment-url="{{ commentUrl }}" 
     data-storage-key="{{ storageKey|default('comment_author_name') }}"
     data-csrf-token="{{ csrf_token(csrfTokenId|default('comment')) }}"
     data-parent-id="" style="display: none;">
    <div class="comment-form-error"></div>
    <div class="comment-form">
        <div class="comment-form-row">
            <input type="text" class="comment-form-name" placeholder="Ваше имя" required />
        </div>
        <div class="comment-form-editor" contenteditable="true" data-placeholder="Ваш комментарий..."></div>
        <div class="comment-form-actions">
            <button type="button" class="btn-submit">Отправить</button>
            <button type="button" class="btn-cancel">Отмена</button>
        </div>
    </div>
</div>
