{% extends 'site/base.html.twig' %}

{% block title %}Поэт Хренов{% endblock %}

{% block body %}
<div class="container mx-auto p-4">
    {% if favoriteGroups|length > 0 %}
        <div class="columns-2">
            {% for group in favoriteGroups %}
                <div class="block border rounded hover:bg-gray-50">
                    <a href="{{ path('site_group', {'id': group.id}) }}">{{ group.title }}</a>
                    <span>({{ group.comment }})</span>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p>Пока нет избранных сборников.</p>
    {% endif %}
</div>
{% endblock %}
