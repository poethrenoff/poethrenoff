{% extends 'site/base.html.twig' %}

{% block title %}Поэт Хренов{% endblock %}

{% block body %}
<div class="container p-4">
    <div class="columns-2">
        {% for group in favoriteGroups %}
            <div class="py-2">
                <a href="{{ path('site_group', {'id': group.id}) }}">{{ group.title }}</a> ({{ group.comment }})
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
