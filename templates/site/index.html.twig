{% extends 'site/base.html.twig' %}

{% block title %}Главная - Поэт Хренов{% endblock %}

{% block body %}
<div class="container mx-auto p-4">
    {% if favoriteGroups|length > 0 %}
        <div class="grid grid-cols-2">
            {% for group in favoriteGroups %}
                <a href="{{ path('site_group', {'id': group.id}) }}" class="block border rounded hover:bg-gray-50">
                    {{ group.title }} ({{ group.comment }})
                </a>
            {% endfor %}
        </div>
    {% else %}
        <p>Пока нет избранных сборников.</p>
    {% endif %}
</div>
{% endblock %}
