{% extends 'site/base.html.twig' %}

{% block title %}Поэт Хренов :: {{ work.title }}{% endblock %}

{% block content %}
    <h2>
        {{ work.displayTitle }}
    </h2>
    <div class="content">
        <pre>{{ work.text|raw }}</pre>
    </div>
    <p class="meta-text">
        {{ work.comment }}
    </p>
    <div class="work-stats" data-work-id="{{ work.id }}" data-token="{{ csrf_token('work_vote') }}">
        <button class="stat-item vote-btn" data-type="like" title="Нравится">
            👍 <span class="count">{{ work.likesCount|default(0) }}</span>
        </button>
        <button class="stat-item vote-btn" data-type="dislike" title="Не нравится">
            👎 <span class="count">{{ work.dislikesCount|default(0) }}</span>
        </button>
    </div>

    <section class="comments-section">
        <div class="comment-actions-top">
            <a href="#" class="comment-toggle-link" data-target="root">Оставить комментарий</a>
        </div>

        {{ include('common/comments/form.html.twig', {
            commentUrl: path('work_comment_save', {id: work.id}),
            storageKey: 'work_comment_author_name',
            csrfTokenId: 'site_comment'
        }) }}

        {% if rootComments is not empty %}
            {{ include('common/comments/tree.html.twig', {comments: rootComments}) }}
        {% endif %}
    </section>

    {% if prev_work or next_work %}
        <div class="side-nav">
            {% if prev_work %}
                <a href="{{ path('site_work', {'id': prev_work.id}) }}" class="nav-arrow nav-prev" title="Предыдущее произведение">
                    <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </a>
            {% endif %}
            {% if next_work %}
                <a href="{{ path('site_work', {'id': next_work.id}) }}" class="nav-arrow nav-next" title="Следующее произведение">
                    <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('assets/js/comments.js') }}"></script>
    <script src="{{ asset('assets/js/navigation.js') }}"></script>
    <script src="{{ asset('assets/js/vote.js') }}"></script>
{% endblock %}
