{% extends 'site/base.html.twig' %}

{% block title %}Поэт Хренов :: {{ work.title }}{% endblock %}

{% block content %}
    <h2>
        {{ work.displayTitle }}
    </h2>
    <div class="content">
        <pre>{{ work.text|raw }}</pre>
    </div>
    <p class="meta-text">
        {{ work.comment }}
    </p>
    {% if work.likesCount is not null or work.dislikesCount is not null %}
        <div class="work-stats">
            <span class="stat-item">👍 {{ work.likesCount|default(0) }}</span>
            <span class="stat-item">👎 {{ work.dislikesCount|default(0) }}</span>
        </div>
    {% endif %}

    {% if prev_work or next_work %}
        <div class="work-nav">
            {% if prev_work %}
                <a href="{{ path('site_work', {'id': prev_work.id}) }}" class="nav-arrow nav-prev" title="Предыдущее произведение">
                    <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </a>
            {% endif %}
            {% if next_work %}
                <a href="{{ path('site_work', {'id': next_work.id}) }}" class="nav-arrow nav-next" title="Следующее произведение">
                    <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
