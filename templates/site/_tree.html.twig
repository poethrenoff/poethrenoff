{% for item in tree %}
    <div class="py-1">
        <a href="{{ path('site_group', {'id': item.group.id}) }}">{{ item.group.title }}</a>
    </div>
    {% if item.children is not empty %}
        <div class="ml-8">
            {% include 'site/_tree.html.twig' with {'tree': item.children} %}
        </div>
    {% endif %}
{% endfor %}
