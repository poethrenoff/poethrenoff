{% for item in tree %}
    <div class="padding-group">
        <a href="{{ path('site_group', {'id': item.group.id}) }}">{{ item.group.title }}</a>
    </div>
    {% if item.children is not empty %}
        <div class="group-tree-indent">
            {% include 'site/group_tree.html.twig' with {'tree': item.children} %}
        </div>
    {% endif %}
{% endfor %}
