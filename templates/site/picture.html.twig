{% extends 'site/base.html.twig' %}

{% block title %}Поэт Хренов :: Картинки{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" integrity="sha384-GPAzSuZc0kFvdIev6wm9zg8gnafE8tLso7rsAYQfc9hAdWCpOcpcNI5W9lWkYcsd" crossorigin="anonymous" />
{% endblock %}

{% block content %}
    <div class="gallery-grid">
        {% for picture in pictures %}
            <div class="border">
                <a href="{{ picture.imagePath }}" class="glightbox" data-gallery="gallery" data-title="{{ picture.title|default('') }}">
                    <img
                        src="{{ picture.imagePath }}"
                        alt="{{ picture.title|default('Gallery image') }}"
                        class="gallery-img"
                        loading="lazy"
                    />
                </a>
            </div>
        {% endfor %}
    </div>

    {% include 'common/pagination.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/gh/mcstudios/glightbox/dist/js/glightbox.min.js" integrity="sha384-MZZbZ6RXJudK43v1qY1zOWKOU2yfeBPatuFoKyHAaAgHTUZhwblRTc9CphTt4IGQ" crossorigin="anonymous"></script>
    <script>
        const lightbox = GLightbox({
            selector: '.glightbox',
            touchNavigation: true,
            loop: true
        });
    </script>
{% endblock %}
