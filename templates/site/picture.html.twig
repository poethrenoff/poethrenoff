{% extends 'site/base.html.twig' %}

{% block title %}Поэт Хренов :: Картинки{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
{% endblock %}

{% block body %}
<div class="container p-4">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6">
        {% for picture in pictures %}
            <div class="border">
                <a href="{{ picture.imagePath }}" class="glightbox" data-gallery="gallery" data-title="{{ picture.title|default('') }}">
                    <img
                        src="{{ picture.imagePath }}"
                        alt="{{ picture.title|default('Gallery image') }}"
                        class="w-full h-full object-cover hover:scale-105 transition-transform"
                        loading="lazy"
                    />
                </a>
            </div>
        {% endfor %}
    </div>

    {% if pictures is not empty and pagination is defined %}
        <div class="pagination">
            {% if pagination.prev_page %}
                <a href="{{ path('site_picture', {'page': pagination.prev_page}) }}" class="pagination-link">&laquo; Назад</a>
            {% endif %}

            {% for page in range(1, pagination.total_pages) %}
                {% if page == pagination.current_page %}
                    <span class="pagination-current">{{ page }}</span>
                {% elseif page in [pagination.current_page - 2, pagination.current_page - 1, pagination.current_page + 1, pagination.current_page + 2] %}
                    <a href="{{ path('site_picture', {'page': page}) }}" class="pagination-link">{{ page }}</a>
                {% elseif page == 1 or page == pagination.total_pages %}
                     <a href="{{ path('site_picture', {'page': page}) }}" class="pagination-link">{{ page }}</a>
                {% elseif page == pagination.current_page - 3 or page == pagination.current_page + 3 %}
                    <span class="pagination-ellipsis">...</span>
                {% endif %}
            {% endfor %}

            {% if pagination.next_page %}
                <a href="{{ path('site_picture', {'page': pagination.next_page}) }}" class="pagination-link">Вперед &raquo;</a>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/gh/mcstudios/glightbox/dist/js/glightbox.min.js"></script>
    <script>
        const lightbox = GLightbox({
            selector: '.glightbox',
            touchNavigation: true,
            loop: true
        });
    </script>
{% endblock %}
