{% extends 'site/base.html.twig' %}

{% block title %}Поэт Хренов :: {% if group is not empty %}{{ group.title }}{% else %}Все{% endif %}{% endblock %}

{% block body %}
<div class="container p-4">
    <div class="columns-2">
    {% if tree is not empty %}
        {% include 'site/_tree.html.twig' with {'tree': tree} %}
    {% elseif works is not empty %}
        {% for work in works %}
            <div class="py-1">
                {{ loop.index }}. <a href="{{ path('site_work', {'id': work.id}) }}">{{ work.title }}</a>
            </div>
        {% endfor %}
    {% endif %}
    </div>
</div>
{% endblock %}
