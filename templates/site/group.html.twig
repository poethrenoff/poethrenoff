{% extends 'site/base.html.twig' %}

{% block title %}Поэт Хренов :: {% if group is not empty %}{{ group.title }}{% endif %}{% endblock %}

{% block body %}
<div class="container mx-auto p-4 grid grid-cols-2">
    {% if tree is not empty %}
        {% include 'site/_tree.html.twig' with {'tree': tree} %}
    {% elseif works is not empty %}
        {% for work in works %}
            <p class="mb-2">
                <a href="{{ path('site_work', {'id': work.id}) }}">{{ work.title }}</a>
            </p>
        {% endfor %}
    {% else %}
        <p>В этом разделе пока нет произведений.</p>
    {% endif %}
</div>
{% endblock %}
