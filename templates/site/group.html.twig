{% extends 'site/base.html.twig' %}

{% block title %}Поэт Хренов :: {% if group is not empty %}{{ group.title }}{% else %}Все{% endif %}{% endblock %}

{% block body %}
<div class="container p-4">
    {% if tree is not empty %}
        <div class="columns-2">
            {% include 'site/_tree.html.twig' with {'tree': tree} %}
        </div>
    {% endif %}

    {% if works is not empty %}
        <div class="columns-2{% if tree is not empty %} mt-6 pt-6 border-t{% endif %}">
            {% for work in works %}
                <div class="py-1">
                    {{ loop.index }}. <a href="{{ path('site_work', {'id': work.id}) }}">{{ work.title }}</a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}

