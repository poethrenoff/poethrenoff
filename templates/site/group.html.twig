{% extends 'site/base.html.twig' %}

{% block title %}Поэт Хренов :: {% if group is not empty %}{{ group.title }}{% else %}Все{% endif %}{% endblock %}

{% block content %}
    {% if tree is not empty %}
        <div class="columns-2">
            {% include 'site/group_tree.html.twig' with {'tree': tree} %}
        </div>
    {% endif %}

    {% if works is not empty %}
        <div class="columns-2{% if tree is not empty %} group-works-list{% endif %}">
            {% for work in works %}
                <div class="padding-group">
                    {{ loop.index }}. <a href="{{ path('site_work', {'id': work.id}) }}">{{ work.title }}</a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

