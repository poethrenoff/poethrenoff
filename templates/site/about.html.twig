{% extends 'site/base.html.twig' %}

{% block title %}О себе - Поэт Хренов{% endblock %}

{% block body %}
<div class="container mx-auto p-4">
    {# Breadcrumbs will be dynamically generated in the controller #}
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li><a href="{{ path('site_homepage') }}">Все</a></li>
            <li aria-current="page">О себе</li>
        </ol>
    </nav>

    <article class="bg-white p-6 rounded shadow prose max-w-none w-full">
        <h1 class="text-3xl font-bold mb-4">Об авторе</h1>
        
        {# Content from StaticText with slug 'about' will be rendered here #}
        <div class="content">
            {{ aboutContent.content|raw }} {# Render the raw HTML content #}
        </div>
    </article>
</div>
{% endblock %}
