<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Поэт Хренов{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/normalize.css@8.0.1/normalize.min.css}">
    <link rel="stylesheet" href="{{ asset('assets/site.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <header class="site-header">
        <div class="container site-header-bar">
            <nav>
                <ol class="breadcrumb">
                {% if breadcrumbs is defined and breadcrumbs is not empty %}
                    {% for breadcrumb in breadcrumbs %}
                        <li>
                            <a href="{{ breadcrumb.path }}">{{ breadcrumb.label }}</a>
                        </li>
                    {% endfor %}
                {% endif %}
                </ol>
            </nav>
            <a href="{{ path('site_homepage') }}" class="site-title">Поэт Хренов</a>
        </div>
    </header>

    <main class="container main-content">
        {% block body %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container site-footer-bar">
            <div class="site-footer-links">
                <div>
                    <a href="{{ path('site_about') }}">Об авторе</a> |
                    <a href="{{ path('site_picture') }}">Картинки</a> |
                    <a href="{{ path('site_search') }}">Поиск</a>
                </div>
                <div>
                    <a href="{{ path('site_work_index') }}">Все</a> |
                    <a href="{{ path('site_random') }}">Случайное</a>
                </div>
            </div>
            <!-- Yandex.Metrika counter -->
            <script type="text/javascript" >
               (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
               m[i].l=1*new Date();
               for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
               k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,k.onload=function(){m[i]('hit')},k.onerror=function(){m[i]('exception', 'Yandex Metrika load error')},a.parentNode.insertBefore(k,a)})
               (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

               ym(101174809, "init", {
                    clickmap:true,
                    trackLinks:true,
                    accurateTrackBounce:true
               });
            </script>
            <noscript><div><img src="https://mc.yandex.ru/watch/101174809" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
            <!-- /Yandex.Metrika counter -->
        </div>
    </footer>

    {% block javascripts %}{% endblock %}
</body>
</html>
