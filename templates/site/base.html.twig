<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Поэт Хренов{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('assets/normalize.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/site.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <header class="fixed top-0 left-0 right-0 bg-white shadow-inner z-50 h-16">
        <div class="container flex flex-wrap justify-between items-center h-full">
            <nav aria-label="breadcrumb" class="flex-1 min-w-0">
                <ol class="breadcrumb flex flex-wrap items-center">
                {% if breadcrumbs is defined and breadcrumbs is not empty %}
                    {% for breadcrumb in breadcrumbs %}
                        <li>
                            {% if breadcrumb.path is defined and breadcrumb.path %}
                                <a href="{{ breadcrumb.path }}">{{ breadcrumb.label }}</a>
                            {% else %}
                                {{ breadcrumb.label }}
                            {% endif %}
                        </li>
                    {% endfor %}
                {% endif %}
                </ol>
            </nav>
            <h1 class="text-xl font-bold ml-4"><a href="{{ path('site_homepage') }}" class="text-black no-underline hover:no-underline">Поэт Хренов</a></h1>
        </div>
    </header>

    <main class="flex-1 container mx-auto p-4 pt-16 pb-16">
        {% block body %}{% endblock %}
    </main>

    <footer class="fixed bottom-0 left-0 right-0 bg-white shadow-inner z-50 h-16">
        <div class="container h-full flex flex-col justify-center gap-2 text-xs text-gray-400 text-center">
            <div class="flex flex-wrap justify-between items-center text-sm text-gray-500 w-full text-left gap-2">
                <a href="{{ path('site_about') }}" class="text-blue-500 hover:underline">Об авторе</a>
                <span>|</span>
                <a href="{{ path('site_picture') }}" class="text-blue-500 hover:underline">Картинки</a>
                <span>|</span>
                <a href="{{ path('site_search') }}" class="text-blue-500 hover:underline">Поиск</a>
                <a href="{{ path('site_work_index') }}" class="text-blue-500 hover:underline ml-auto">Все</a>
                <span>|</span>
                <a href="{{ path('site_random') }}" class="text-blue-500 hover:underline">Случайное</a>
            </div>
            <!-- Yandex.Metrika counter -->
            <script type="text/javascript" >
               (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
               m[i].l=1*new Date();
               for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
               k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,k.onload=function(){m[i]('hit')},k.onerror=function(){m[i]('exception', 'Yandex Metrika load error')},a.parentNode.insertBefore(k,a)})
               (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

               ym(101174809, "init", {
                    clickmap:true,
                    trackLinks:true,
                    accurateTrackBounce:true
               });
            </script>
            <noscript><div><img src="https://mc.yandex.ru/watch/101174809" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
            <!-- /Yandex.Metrika counter -->
        </div>
    </footer>

    {% block javascripts %}{% endblock %}
</body>
</html>
