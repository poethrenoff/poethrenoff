{% extends 'base.html.twig' %}

{% block title %}404 - Страница не найдена{% endblock %}

{% block body %}
    <div style="text-align: center; padding: 200px 20px;">
        <h1 style="font-size: 120px; margin: 0; color: var(--accent); line-height: 1;">404</h1>
        <p style="font-size: 24px; color: var(--fg); margin: 30px 0;">Упс! Страница потерялась во времени и пространстве.</p>
        <p style="margin-top: 40px;">
            <a href="/" style="display: inline-block; padding: 12px 30px; background-color: var(--accent); color: var(--white); text-decoration: none; border-radius: 4px; font-weight: bold;">Вернуться на главную</a>
        </p>
    </div>
{% endblock %}
