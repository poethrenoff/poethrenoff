{% extends 'work/base.html.twig' %}

{% block content %}
    <div x-data="app" x-cloak>
        <header class="site-header">
            <div class="site-header-bar">
                <a href="/" class="site-title">Мастерская</a>
                <p x-show="generalError" class="general-error" x-text="generalError"></p>
                <nav>
                    <a href="#" @click.prevent="go('feed')" :class="view==='feed' ? 'active' : ''">Лента</a>
                    <a href="#" @click.prevent="go('audio')" :class="view==='audio' ? 'active' : ''">Записи</a>
                    <a href="#" @click.prevent="go('trash')" :class="view==='trash' ? 'active' : ''">Корзина</a>
                </nav>
            </div>
        </header>

        <div class="dashboard-panel" x-show="stats.total !== undefined && view !== 'trash'">
            <div class="dash-row">
                <div class="dash-stat">
                    <span class="dash-value" x-text="stats.total"></span>
                    <span class="dash-label">Стихов</span>
                </div>
                <div class="dash-stat">
                    <span class="dash-value" x-text="stats.trash"></span>
                    <span class="dash-label">В корзине</span>
                </div>
            </div>
            <div class="dash-row">
                <div class="dash-stat">
                    <span class="dash-value" x-text="stats.streak"></span>
                    <span class="dash-label">Дней подряд</span>
                </div>
                <div class="dash-stat">
                    <span class="dash-value" x-text="stats.max_streak"></span>
                    <span class="dash-label">Макс. дней подряд</span>
                </div>
            </div>
        </div>

        <div class="toc-panel" x-show="toc.length > 0 && view !== 'audio'">
            <div class="toc-list">
                <template x-for="item in toc" :key="item.id">
                    <a class="toc-link" @click.prevent="scrollToPoem(item.id)" x-text="item.title"></a>
                </template>
            </div>
        </div>

        <main x-show="view==='feed'" class="container main-content">
            <div class="toolbar">
                <button class="icon-btn" @click="openNew()" title="Новый стих">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
                <span x-show="loading" class="loading">Загрузка…</span>
                <button class="icon-btn" @click="exportPoems()" title="Экспорт">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                </button>
            </div>

            <div x-show="showNew" class="poem" x-ref="newForm">
                <div class="poem-header">
                    <div class="title">
                        <input class="title-input" tabindex="1" x-model="newTitle" placeholder="Название" @keydown.enter="create()" @keydown.escape="showNew = false" spellcheck="true" lang="ru">
                    </div>
                    <div class="poem-actions edit-actions">
                        <button class="icon-btn" @click="create()" title="Сохранить">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </button>
                        <button class="icon-btn" @click="cancelNew()" title="Отмена">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </button>
                    </div>
                </div>
                <textarea class="poem-textarea" tabindex="2" x-model="newContent" placeholder="Текст стиха" rows="10" @keydown.escape="showNew = false" spellcheck="true" lang="ru"></textarea>
                <input class="comment-input" tabindex="3" type="text" x-model="newComment" placeholder="дд.мм.гггг" @keydown.enter="create()" @keydown.escape="showNew = false">
            </div>

            <div x-ref="list">
                <template x-for="poem in (view === 'feed' ? poems : [])" :key="poem.id">
                    <div class="poem" :class="{ editing: editingId === poem.id }" :id="'poem-' + poem.id">
                        <div class="poem-header">
                            <div class="poem-body" x-show="editingId !== poem.id">
                                <div class="poem-title" x-text="poem.title || '* * *'"></div>
                                <div class="poem-content" x-text="poem.content"></div>
                                <div class="poem-comment" x-show="poem.comment" x-text="poem.comment"></div>
                            </div>
                            <input class="title-input" tabindex="1" x-model="poem.title" x-show="editingId === poem.id" placeholder="Название" @keydown.enter="saveEdit(poem)" @keydown.escape="cancelEdit()" spellcheck="true" lang="ru">
                            <div class="poem-actions view-actions" x-show="editingId !== poem.id">
                                <button class="icon-btn copy-btn" :data-copy-id="poem.id" @click="copyPoem(poem)" title="Копировать">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                </button>
                                <button class="icon-btn" @click="edit(poem)" title="Редактировать">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </button>
                                <button class="icon-btn" @click="trash(poem)" title="В корзину">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                </button>
                            </div>
                            <div class="poem-actions edit-actions" x-show="editingId === poem.id">
                                <button class="icon-btn" @click="saveEdit(poem)" title="Сохранить">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                </button>
                                <button class="icon-btn" @click="cancelEdit()" title="Отмена">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                </button>
                            </div>
                        </div>
                        <textarea class="poem-textarea" tabindex="2" x-model="poem.content" x-show="editingId === poem.id" placeholder="Текст стиха" rows="10" @keydown.escape="cancelEdit()" spellcheck="true" lang="ru"></textarea>
                        <input class="comment-input" tabindex="3" type="text" x-model="poem.comment" x-show="editingId === poem.id" placeholder="ДД.ММ.ГГГГ" @keydown.enter="saveEdit(poem)" @keydown.escape="cancelEdit()">
                        <button class="icon-btn drag-handle" title="Перетащить" @click.prevent x-show="editingId !== poem.id">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="5" r="1"></circle><circle cx="9" cy="12" r="1"></circle><circle cx="9" cy="19" r="1"></circle><circle cx="15" cy="5" r="1"></circle><circle cx="15" cy="12" r="1"></circle><circle cx="15" cy="19" r="1"></circle></svg>
                        </button>
                    </div>
                </template>
            </div>

            <div x-show="!loading && poems.length === 0" class="empty">
                Пока пусто. Нажмите «Новый стих», чтобы начать.
            </div>
        </main>
        <main x-show="view==='audio'" class="container main-content">
            <div class="toolbar">
                <button class="icon-btn" @click="startRecording()" x-show="!isRecording" title="Записать">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="red" stroke="red"><circle cx="12" cy="12" r="10"/></svg>
                </button>
                <div class="recording-controls" x-show="isRecording">
                    <button class="icon-btn" @click="stopRecording()" title="Сохранить запись">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </button>
                    <button class="icon-btn" @click="cancelRecording()" title="Отменить запись">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                    <span class="recording-timer" x-text="formatDuration(recordingTime)"></span>
                </div>
                <span x-show="loading" class="loading">Загрузка…</span>
                <button class="icon-btn" @click="openNew()" title="Новый стих">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
            </div>

            <div x-show="showNew" class="poem" x-ref="newForm">
                <div class="poem-header">
                    <div class="title">
                        <input class="title-input" tabindex="1" x-model="newTitle" placeholder="Название" @keydown.enter="create()" @keydown.escape="showNew = false" spellcheck="true" lang="ru">
                    </div>
                    <div class="poem-actions edit-actions">
                        <button class="icon-btn" @click="create()" title="Сохранить">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </button>
                        <button class="icon-btn" @click="cancelNew()" title="Отмена">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </button>
                    </div>
                </div>
                <textarea class="poem-textarea" tabindex="2" x-model="newContent" placeholder="Текст стиха" rows="10" @keydown.escape="showNew = false" spellcheck="true" lang="ru"></textarea>
                <input class="comment-input" tabindex="3" type="text" x-model="newComment" placeholder="дд.мм.гггг" @keydown.enter="create()" @keydown.escape="showNew = false">
            </div>

            <div class="audio-list">
                <template x-for="item in audio" :key="item.id">
                    <div class="audio-item" :class="{ 'isPlaying': isPlayingId === item.id }">
                        <div class="audio-info">
                            <div class="audio-title">
                                <span x-show="editingAudioId !== item.id" x-text="item.title" @click="editAudio(item)"></span>
                                <input x-show="editingAudioId === item.id"
                                       x-model="item.title"
                                       @keydown.enter="saveAudioRename(item)"
                                       @keydown.escape="cancelAudioRename(item)"
                                       class="inline-edit-input"
                                       :id="'audio-input-' + item.id">
                            </div>
                            <div class="audio-meta">
                                <span x-text="formatDuration(item.duration)"></span> |
                                <span x-text="item.createdAt"></span>
                            </div>
                        </div>
                        <div class="audio-actions">
                            <button class="icon-btn" @click="stopPlayback(item)" title="Стоп" x-show="isPlayingId === item.id || pausedId === item.id">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                            </button>
                            <button class="icon-btn" @click="togglePlay(item)" title="Пауза" x-show="isPlayingId === item.id">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
                            </button>
                            <button class="icon-btn" @click="togglePlay(item)" title="Прослушать" x-show="pausedId === item.id || (isPlayingId !== item.id && pausedId !== item.id)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                            </button>
                            <button class="icon-btn" @click="startRewriting(item)" title="Переписать">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/></svg>
                            </button>
                            <button class="icon-btn" @click="editAudio(item)" title="Переименовать">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            </button>
                            <button class="icon-btn" @click="deleteAudio(item)" title="Удалить">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </div>
                    </div>
                </template>
            </div>

            <div x-show="!loading && audio.length === 0" class="empty">
                Записей пока нет. Нажмите «Записать», чтобы создать первую.
            </div>
        </main>

        <main x-show="view==='trash'" class="container main-content">
            <div class="toolbar">
                <button class="icon-btn" @click="go('feed')" title="В ленту">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                </button>
                <span x-show="loading" class="loading">Загрузка…</span>
            </div>

            <template x-for="poem in (view === 'trash' ? poems : [])" :key="poem.id">
                <div class="poem" :id="'poem-' + poem.id">
                    <div class="poem-header">
                        <div class="poem-body">
                            <div class="poem-title" x-text="poem.title || '* * *'"></div>
                            <div class="poem-content" x-text="poem.content"></div>
                            <div class="poem-comment" x-show="poem.comment" x-text="poem.comment"></div>
                        </div>
                        <div class="poem-actions">
                            <button class="icon-btn" @click="restore(poem)" title="Восстановить">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                            </button>
                            <button class="icon-btn" @click="remove(poem)" title="Удалить навсегда">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                            </button>
                        </div>
                    </div>
                </div>
            </template>

            <div x-show="!loading && poems.length === 0" class="empty">
                Корзина пуста.
            </div>
        </main>

        <button class="scroll-top-btn" @click="scrollToTop()" title="Наверх">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
        </button>
        <button class="scroll-bottom-btn" @click="scrollToBottom()" title="Вниз">
             <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="5 12 12 19 19 12"></polyline></svg>
         </button>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.CSRF_TOKENS = {
            work_poem_create: '{{ csrf_token('work_poem_create') }}',
            work_poem_update: '{{ csrf_token('work_poem_update') }}',
            work_poem_trash: '{{ csrf_token('work_poem_trash') }}',
            work_poem_restore: '{{ csrf_token('work_poem_restore') }}',
            work_poem_reorder: '{{ csrf_token('work_poem_reorder') }}',
            work_poem_delete: '{{ csrf_token('work_poem_delete') }}',
            work_audio_create: '{{ csrf_token('work_audio_create') }}',
            work_audio_rename: '{{ csrf_token('work_audio_rename') }}',
            work_audio_rewrite: '{{ csrf_token('work_audio_rewrite') }}',
            work_audio_delete: '{{ csrf_token('work_audio_delete') }}',
        };
    </script>
    <script src="{{ asset('assets/js/work.js') }}"></script>
{% endblock %}
