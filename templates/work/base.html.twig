<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrf_token('work') }}">
    <title>{% block title %}Участок{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('assets/work.css') }}">
    {% block stylesheets %}{% endblock %}
    <script defer src="{{ asset('assets/vendor/Sortable.min.js') }}"></script>
    <script defer src="{{ asset('assets/vendor/alpine.min.js') }}"></script>
</head>

<body>
    {% block body %}{% endblock %}
    {% block javascripts %}{% endblock %}
</body>
</html>
