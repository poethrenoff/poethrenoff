{% extends '@SonataAdmin/CRUD/base_list_field.html.twig' %}

{% block field %}
    {% set shift = object.poems - object.poemsOld %}
    {% if shift > 0 %}
        <nobr>{{ value }} <sup style="color: green">+{{ shift }}</sup></nobr>
    {% elseif shift < 0 %}
        <nobr>{{ value }} <sup style="color: red">{{ shift }}</sup></nobr>
    {% else %}
        {{ value }}
    {% endif %}
{% endblock %}