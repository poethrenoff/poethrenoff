{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
<div class="container" style="margin-top: 50px; max-width: 400px; margin-left: auto; margin-right: auto; padding: 1rem;">
    <form method="post">
        {% if error %}
            <div style="color: #cc3333; margin-bottom: 15px; border: 1px solid #cc3333; padding: 10px;">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <h1>Admin Login</h1>
        <div style="margin-bottom: 10px;">
            <label for="inputEmail" style="display: block; margin-bottom: 5px;">Email</label>
            <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" autocomplete="email" required autofocus style="width: 100%; padding: 8px; box-sizing: border-box;">
        </div>
        <div style="margin-bottom: 10px;">
            <label for="inputPassword" style="display: block; margin-bottom: 5px;">Password</label>
            <input type="password" name="_password" id="inputPassword" autocomplete="current-password" required style="width: 100%; padding: 8px; box-sizing: border-box;">
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" style="padding: 10px 20px; cursor: pointer; background: #1982d1; color: white; border: none; border-radius: 4px;">
            Sign in
        </button>
    </form>
</div>
{% endblock %}
