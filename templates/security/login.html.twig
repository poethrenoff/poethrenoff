{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
<div class="container" style="margin-top: 50px; max-width: 400px; margin-left: auto; margin-right: auto; font-family: sans-serif;">
    <form method="post">
        {% if error %}
            <div class="alert alert-danger" style="color: #cc3333; margin-bottom: 15px; border: 1px solid #cc3333; padding: 10px;">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3">
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('admin_logout') }}">Logout</a>
            </div>
        {% endif %}

        <h1 class="h3 mb-3 font-weight-normal">Admin Login</h1>
        <div style="margin-bottom: 10px;">
            <label for="inputEmail" style="display: block; margin-bottom: 5px;">Email</label>
            <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control" autocomplete="email" required autofocus style="width: 100%; padding: 8px; box-sizing: border-box;">
        </div>
        <div style="margin-bottom: 10px;">
            <label for="inputPassword" style="display: block; margin-bottom: 5px;">Password</label>
            <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" required style="width: 100%; padding: 8px; box-sizing: border-box;">
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="btn btn-lg btn-primary" type="submit" style="padding: 10px 20px; cursor: pointer; background: #1982d1; color: white; border: none; border-radius: 4px;">
            Sign in
        </button>
    </form>
</div>
{% endblock %}
